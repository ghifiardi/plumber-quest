{
  "name": "plumber-quest",
  "version": "1.0.0",
  "description": "A small side-scrolling platformer built with vanilla HTML5 Canvas + ES modules.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/assemble-www.mjs",
    "sync": "npm run build:web && cap sync android",
    "open:android": "cap open android",
    "sync:ios": "npm run build:web && cap sync ios",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@supabase/supabase-js": "^2.107.0",
    "esbuild": "^0.28.0"
  }
}
