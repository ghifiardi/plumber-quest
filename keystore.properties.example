# Copy this file to `keystore.properties` (which is git-ignored) to build a
# signed release locally. For CI builds, set the equivalent GitHub Actions
# secrets instead (see docs/PLAY_STORE.md) — you do NOT need this file there.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
